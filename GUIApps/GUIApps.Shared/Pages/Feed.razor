@page "/"
@using MudBlazor

<MudLayout>
    <MudMainContent Class="grey lighten-4">

        <MudPaper Width="100%" Square="true" Elevation="0"
                  Class="d-flex justify-center align-center py-2 mud-theme-info">
            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-2" />
            <MudText Typo="Typo.caption" Style="font-weight:bold;">
                Banners will be here for changes/maintenances/updates.
            </MudText>
        </MudPaper>

        <MudPaper Elevation="1" Square="true" Class="px-4 py-3 sticky-top z-10 d-flex flex-wrap gap-4 align-center">

            <MudTextField @bind-Value="_searchString" Placeholder="Search requests..." Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Class="flex-grow-1" Style="max-width: 300px; background:white;" />

            <MudSpacer />

            <MudChipSet T="string" Filter="true" Mandatory="true" @bind-SelectedValue="_selectedStatus">
                <MudChip T="string" Text="All" Value="@("All")" Color="Color.Default" Variant="Variant.Outlined" SelectedColor="Color.Primary" />
                <MudChip T="string" Text="New" Value="@("New")" Color="Color.Success" Variant="Variant.Outlined" SelectedColor="Color.Success" />
                <MudChip T="string" Text="Solving" Value="@("Solving")" Color="Color.Warning" Variant="Variant.Outlined" SelectedColor="Color.Warning" />
                <MudChip T="string" Text="Closed" Value="@("Closed")" Color="Color.Dark" Variant="Variant.Outlined" SelectedColor="Color.Dark" />
            </MudChipSet>

            <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />

            <MudIconButton Icon="@Icons.Material.Filled.ViewList" Color="Color.Primary" Size="Size.Small" />
            <MudIconButton Icon="@Icons.Material.Filled.ViewModule" Color="Color.Default" Size="Size.Small" />
        </MudPaper>

        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">

            @foreach (var item in _requests)
            {
                <MudCard Class="mb-4 rounded-lg hover-elevation" Elevation="1">
                    <MudGrid Spacing="0">

                        <MudItem xs="12" sm="4">
                            <MudImage Src="@item.ImageUrl" ObjectFit="ObjectFit.Cover" Height="200" Width="100" Class="rounded-l-lg rounded-tr-none" />
                        </MudItem>

                        <MudItem xs="12" sm="8">
                            <MudCardContent Class="d-flex flex-column justify-space-between h-100 pa-4">

                                <div class="d-flex justify-space-between align-start">
                                    <div class="d-flex align-center">
                                        <MudAvatar Size="Size.Small" Image="@item.UserAvatar" Class="mr-2" />
                                        <div>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@item.UserName • @item.TimeAgo</MudText>
                                        </div>
                                    </div>
                                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(item.Status)" Label="true">@item.Status</MudChip>
                                </div>

                                <div class="mt-2">
                                    <MudText Typo="Typo.h6" Style="font-weight: 700; line-height: 1.2;">@item.Title</MudText>
                                    <div class="d-flex align-center mt-1">
                                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Color="Color.Primary" Class="mr-1" />
                                        <MudText Typo="Typo.caption" Color="Color.Default">@item.Location</MudText>
                                    </div>
                                </div>

                                <div class="d-flex justify-space-between align-center mt-3 pt-3" style="border-top: 1px solid #eee;">
                                    <div class="d-flex gap-2">
                                        <MudButton StartIcon="@Icons.Material.Filled.ThumbUp" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">
                                            @item.Likes
                                        </MudButton>
                                        <MudButton StartIcon="@Icons.Material.Outlined.ChatBubble" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">
                                            Comments
                                        </MudButton>
                                    </div>
                                    <MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small" Color="Color.Default" />
                                </div>

                            </MudCardContent>
                        </MudItem>
                    </MudGrid>
                </MudCard>
            }
        </MudContainer>
    </MudMainContent>
</MudLayout>

<style>
    /* Custom utility to make the filter bar stick to top */
    .sticky-top {
        position: sticky;
        top: 0;
        z-index: 100;
        background-color: white;
        border-bottom: 1px solid #e0e0e0;
    }
    /* Subtle hover effect for cards */
    .hover-elevation:hover {
        box-shadow: 0px 4px 20px rgba(0,0,0,0.1) !important;
        transition: box-shadow 0.3s ease;
    }
</style>

@code {
    private string _searchString = "";
    private string _selectedStatus = "All";

    // Mock Data
    private List<RequestItem> _requests = new List<RequestItem>
    {
        new RequestItem {
            Title = "Damaged sidewalk on Main St.",
            UserName = "Peter Novák",
            UserAvatar = "https://i.pravatar.cc/150?u=1",
            ImageUrl = "https://picsum.photos/400/300?random=1",
            Location = "Trenčín, Centrum",
            Status = "Solving",
            Likes = 12,
            TimeAgo = "2 hours ago"
        },
        new RequestItem {
            Title = "Illegal dumping near the park",
            UserName = "Maria Horváthová",
            UserAvatar = "https://i.pravatar.cc/150?u=2",
            ImageUrl = "https://picsum.photos/400/300?random=2",
            Location = "Bratislava, Ružinov",
            Status = "New",
            Likes = 45,
            TimeAgo = "1 day ago"
        },
        new RequestItem {
            Title = "Broken streetlight",
            UserName = "Ján Kováč",
            UserAvatar = "https://i.pravatar.cc/150?u=3",
            ImageUrl = "https://picsum.photos/400/300?random=3",
            Location = "Košice, Sever",
            Status = "Closed",
            Likes = 8,
            TimeAgo = "3 days ago"
        }
    };

    private Color GetStatusColor(string status) => status switch
    {
        "New" => Color.Success,
        "Solving" => Color.Warning,
        "Closed" => Color.Dark,
        _ => Color.Default
    };

    public class RequestItem
    {
        public string Title { get; set; }
        public string UserName { get; set; }
        public string UserAvatar { get; set; }
        public string ImageUrl { get; set; }
        public string Location { get; set; }
        public string Status { get; set; }
        public int Likes { get; set; }
        public string TimeAgo { get; set; }
    }
}