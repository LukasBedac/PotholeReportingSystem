@page "/statistics"
@using MudBlazor
@using GUIApps.Shared.Models
@using GUIApps.Shared.Models.Enums
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar

<PageTitle>@Loc["Statistics"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6 mb-12">
    <MudText Typo="Typo.h4" Class="mb-6">@Loc["GlobalStats"]</MudText>

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mx-auto mt-10 d-block" />
    }
    else if (_reports == null || !_reports.Any())
    {
        <MudAlert Severity="Severity.Info">@Loc["NoStatsData"]</MudAlert>
    }
    else
    {
        <MudGrid>
            <!-- High-level stats -->
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex flex-column align-center justify-center rounded-lg" Elevation="2" Style="min-height: 120px;">
                    <MudText Typo="Typo.h3" Color="Color.Primary">@_reports.Count</MudText>
                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary">@Loc["TotalReports"]</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex flex-column align-center justify-center rounded-lg" Elevation="2" Style="min-height: 120px;">
                    <MudText Typo="Typo.h3" Color="Color.Success">@_repairedCount</MudText>
                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary">@Loc["Repaired"]</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex flex-column align-center justify-center rounded-lg" Elevation="2" Style="min-height: 120px;">
                    <MudText Typo="Typo.h3" Color="Color.Warning">@_inProgressCount</MudText>
                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary">@Loc["Inprogress"]</MudText>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudPaper Class="pa-4 d-flex flex-column align-center justify-center rounded-lg" Elevation="2" Style="min-height: 120px;">
                    <MudText Typo="Typo.h3" Color="Color.Info">@_newReportsCount</MudText>
                    <MudText Typo="Typo.subtitle1" Color="Color.Secondary">@Loc["Reported"]</MudText>
                </MudPaper>
            </MudItem>

            <!-- Charts -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg d-flex flex-column align-center text-center" Elevation="2" Style="height: 100%;">
                    <MudText Typo="Typo.h6" Class="mb-4">@Loc["ReportsByStatus"]</MudText>
                    <div style="flex-grow: 1;" class="d-flex justify-center align-center w-100">
                        @if (_statusData.Length > 0)
                        {
                            <MudChart ChartType="ChartType.Donut" InputData="@_statusData" InputLabels="@_statusLabels" Width="300px" Height="300px" />
                        }
                        else
                        {
                            <MudText>@Loc["NoStatsData"]</MudText>
                        }
                    </div>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                 <MudPaper Class="pa-4 rounded-lg d-flex flex-column align-center text-center" Elevation="2" Style="height: 100%;">
                    <MudText Typo="Typo.h6" Class="mb-4">@Loc["ReportsByCategory"]</MudText>
                    <div style="flex-grow: 1;" class="d-flex justify-center align-center w-100">
                        @if (_categoryData.Length > 0)
                        {
                            <MudChart ChartType="ChartType.Pie" InputData="@_categoryData" InputLabels="@_categoryLabels" Width="300px" Height="300px" />
                        }
                        else
                        {
                            <MudText>@Loc["NoStatsData"]</MudText>
                        }
                    </div>
                </MudPaper>
            </MudItem>

            <!-- Top Cities/Regions -->
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="height: 100%">
                    <MudText Typo="Typo.h6" Class="mb-4">@Loc["TopCities"]</MudText>
                    <MudList T="string" Dense="true" DisablePadding="true" Clickable="false">
                        @foreach (var city in _topCities)
                        {
                            <MudListItem>
                                <div class="d-flex justify-space-between w-100 align-center">
                                    <MudText>@city.Key</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@city.Value @Loc["ReportedLC"]</MudChip>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                    @if (!_topCities.Any())
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["NoCityData"]</MudText>
                    }
                </MudPaper>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4 rounded-lg" Elevation="2" Style="height: 100%">
                    <MudText Typo="Typo.h6" Class="mb-4">@Loc["TopDistricts"]</MudText>
                    <MudList T="string" Dense="true" DisablePadding="true" Clickable="false">
                        @foreach (var region in _topRegions)
                        {
                            <MudListItem>
                                <div class="d-flex justify-space-between w-100 align-center">
                                    <MudText>@region.Key</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@region.Value @Loc["ReportedLC"]</MudChip>
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                    @if (!_topRegions.Any())
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["NoDistrictData"]</MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private List<Report>? _reports;

    private int _repairedCount = 0;
    private int _inProgressCount = 0;
    private int _newReportsCount = 0;

    private double[] _statusData = Array.Empty<double>();
    private string[] _statusLabels = Array.Empty<string>();

    private double[] _categoryData = Array.Empty<double>();
    private string[] _categoryLabels = Array.Empty<string>();

    private List<KeyValuePair<string, int>> _topCities = new();
    private List<KeyValuePair<string, int>> _topRegions = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadStatisticsAsync();
    }

    private string FormatEnumName<T>(T value) where T : Enum
    {
        return Loc[value.ToString()].Value;
    }

    private async Task LoadStatisticsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("ReportService");
            _reports = await client.GetFromJsonAsync<List<Report>>("api/reports");

            if (_reports != null && _reports.Any())
            {
                CalculateStats();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading reports for stats: {ex}");
            Snackbar.Add(Loc["FailedLoadReports"].Value, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void CalculateStats()
    {
        if (_reports == null) return;

        _repairedCount = _reports.Count(r => r.Status == ReportStatus.Repaired);
        _inProgressCount = _reports.Count(r => r.Status == ReportStatus.Inprogress || r.Status == ReportStatus.UnderReview);
        _newReportsCount = _reports.Count(r => r.Status == ReportStatus.Reported);

        var statusGroups = _reports
            .GroupBy(r => r.Status)
            .Select(g => new { Label = FormatEnumName(g.Key), Count = (double)g.Count() })
            .ToList();
        _statusLabels = statusGroups.Select(s => $"{s.Label} ({s.Count})").ToArray();
        _statusData = statusGroups.Select(s => s.Count).ToArray();

        var categoryGroups = _reports
            .GroupBy(r => r.Category)
            .Select(g => new { Label = FormatEnumName(g.Key), Count = (double)g.Count() })
            .ToList();
        _categoryLabels = categoryGroups.Select(s => $"{s.Label} ({s.Count})").ToArray();
        _categoryData = categoryGroups.Select(s => s.Count).ToArray();

        _topCities = _reports
            .Where(r => !string.IsNullOrWhiteSpace(r.City))
            .GroupBy(r => r.City!)
            .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
            .OrderByDescending(kv => kv.Value)
            .Take(5)
            .ToList();

        _topRegions = _reports
            .Where(r => !string.IsNullOrWhiteSpace(r.District))
            .GroupBy(r => r.District!)
            .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
            .OrderByDescending(kv => kv.Value)
            .Take(5)
            .ToList();
    }
}