@page "/myreports"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using GUIApps.Shared.Models
@using GUIApps.Shared.Models.Enums
@using MudBlazor
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation

<PageTitle>@Loc["MyReports"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h5" Class="mb-4">@Loc["MyReports"]</MudText>

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_reports == null || !_reports.Any())
    {
        <MudAlert Severity="Severity.Info">@Loc["NoReportsYet"]</MudAlert>
    }
    else
    {
        <MudTable Items="@_reports" Hover="true" Breakpoint="Breakpoint.Sm" Loading="@_loading" LoadingProgressColor="Color.Info" Elevation="4">
            <HeaderContent>
                <MudTh>@Loc["Image"]</MudTh>
                <MudTh>@Loc["Category"]</MudTh>
                <MudTh>@Loc["Status"]</MudTh>
                <MudTh>@Loc["Date"]</MudTh>
                <MudTh>@Loc["Description"]</MudTh>
                <MudTh>@Loc["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@Loc["Image"]">
                    @if (context.Image != null && !string.IsNullOrEmpty(context.Image.StorageKey))
                    {
                         <MudIcon Icon="@Icons.Material.Filled.Image" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" />
                    }
                </MudTd>
                <MudTd DataLabel="@Loc["Category"]">@Loc[context.Category.ToString()]</MudTd>
                <MudTd DataLabel="@Loc["Status"]">
                     <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">@Loc[context.Status.ToString()]</MudChip>
                </MudTd>
                <MudTd DataLabel="@Loc["Date"]">@context.ReportedAt.ToLocalTime().ToString("g")</MudTd>
                <MudTd DataLabel="@Loc["Description"]">
                    <MudText Typo="Typo.body2" Style="max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        @context.Description
                    </MudText>
                </MudTd>
                <MudTd DataLabel="@Loc["Actions"]">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => EditReport(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteReportAsync(context))" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    }
</MudContainer>

    @code {
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<Report>? _reports;
    private bool _loading = true;
    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            var authState = AuthenticationStateTask is null ? null : await AuthenticationStateTask;
            _userId = authState?.User?.FindFirst("sub")?.Value 
                      ?? authState?.User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(_userId))
            {
                Snackbar.Add(Loc["LoginRequired"].Value, Severity.Error);
                _loading = false;
                return;
            }

            var client = HttpClientFactory.CreateClient("ReportService");

            _reports = await client.GetFromJsonAsync<List<Report>>($"api/Reports/user/{_userId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading reports: {ex}");
            Snackbar.Add(Loc["FailedLoadReports"].Value, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void EditReport(Report report)
    {
        Navigation.NavigateTo($"/edit-report/{report.Id}");
    }

    private async Task DeleteReportAsync(Report report)
    {
        var parameters = new DialogParameters<DialogContent>
        {
            { x => x.ContentText, "Do you really want to delete this report? This process cannot be undone." },
            { x => x.ButtonText, "Delete" },
            { x => x.Color, Color.Error }
        };

        bool? result = await DialogService.ShowMessageBox(
            Loc["Warning"].Value, 
            Loc["ConfirmDelete"].Value, 
            yesText: Loc["Delete"].Value, cancelText: Loc["Cancel"].Value);

        if (result == true)
        {
            try
            {
                var client = HttpClientFactory.CreateClient("ReportService");
                var response = await client.DeleteAsync($"api/Reports/{report.Id}");

                if (response.IsSuccessStatusCode)
                {
                   Snackbar.Add(Loc["ReportDeleted"].Value, Severity.Success);
                   if (_reports != null) _reports.Remove(report);
               }
               else
               {
                   Snackbar.Add(Loc["DeleteFailed"].Value, Severity.Error);
               }
            }
            catch(Exception ex)
            {
               Console.WriteLine($"Error deleting report: {ex}");
               Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }

    private Color GetStatusColor(ReportStatus status)
    {
        return status switch
        {
            ReportStatus.Reported => Color.Primary,
            ReportStatus.UnderReview => Color.Info,
            ReportStatus.Inprogress => Color.Success,
            ReportStatus.Rejected => Color.Error,
            ReportStatus.CannotBeRepaired => Color.Error,
            _ => Color.Default
        };
    }
    
    // Helper class if DialogParameters<T> needs a type, otherwise Map is used.
    // But MessageBox uses string args primarily.
    private class DialogContent { public string ContentText { get; set; } = ""; public string ButtonText { get; set; } = ""; public Color Color { get; set; } }
}
