@page "/admin/edit-report/{Id:guid}"
@page "/edit-report/{Id:guid}"
@using GUIApps.Shared.Models
@using GUIApps.Shared.Models.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

@attribute [Authorize]
@implements IDisposable

<PageTitle>@Loc["Edit Reports"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudText Typo="Typo.h4" Class="mb-4">@Loc["EditReports"]</MudText>

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_report == null)
    {
        <MudAlert Severity="Severity.Error">Report not found.</MudAlert>
    }
    else
    {
        <MudCard>
            <MudCardContent>
                <MudForm @ref="_form">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField Label="@Loc["Report ID"]" Value="@_report.Id" ReadOnly="true" Variant="Variant.Filled" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="@Loc["User ID"]" Value="@_report.UserID" ReadOnly="true" Variant="Variant.Filled" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="@Loc["Reported"]" Value="@_report.ReportedAt.ToLocalTime().ToString("g")" ReadOnly="true" Variant="Variant.Filled" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                             <MudSelect T="ReportStatus" Label="Status" @bind-Value="_report.Status" Variant="Variant.Outlined" Required="true" Disabled="@(!_isAdmin)">
                                @foreach (var status in Enum.GetValues<ReportStatus>())
                                {
                                    <MudSelectItem Value="@status">@status</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSelect T="PotholeCategory" Label="Category" @bind-Value="_report.Category" Variant="Variant.Outlined" Required="true">
                                @foreach (var cat in Enum.GetValues<PotholeCategory>())
                                {
                                    <MudSelectItem Value="@cat">@cat</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Description" @bind-Value="_report.Description" Lines="4" Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle1" Class="mb-2">Map Location</MudText>
                            <div id="picker-map" style="height: 250px; width: 100%; border-radius: 8px; border: 1px solid var(--mud-palette-lines-default); z-index: 1;"></div>
                            <div class="d-flex justify-space-between align-center mt-2">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Drag the pin or click on the map to manually set the exact location.
                                </MudText>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="RevertLocationAsync">Revert Position</MudButton>
                            </div>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Latitude" @bind-Value="_report.Latitude" ReadOnly="false" Variant="Variant.Filled" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Longitude" @bind-Value="_report.LongTitude" ReadOnly="false" Variant="Variant.Filled" />
                        </MudItem>

                        @if (_report.Image != null && !string.IsNullOrEmpty(_report.Image.StorageKey))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle1">Attached Media</MudText>
                                @if (_report.Image.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                                {
                                    <MudImage Src="@($"/api/files/view/{_report.Image.BucketName}/{_report.Image.StorageKey}")" Alt="Attached Photo" Elevation="2" Class="rounded-lg mb-2" Style="max-width: 100%; max-height: 400px; display: block;" ObjectFit="ObjectFit.Contain" />
                                }
                                else if (_report.Image.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase))
                                {
                                    <video controls style="max-width: 100%; max-height: 400px; display: block;" class="rounded-lg mb-2">
                                        <source src="@($"/api/files/view/{_report.Image.BucketName}/{_report.Image.StorageKey}")" type="@_report.Image.ContentType" />
                                        Your browser does not support the video tag.
                                    </video>
                                }
                                <MudChip T="string" Color="Color.Info" Icon="@Icons.Material.Filled.Attachment">@_report.Image.OriginalName</MudChip>
                                <MudText Typo="Typo.caption">Size: @(_report.Image.SizeBytes / 1024) KB</MudText>
                            </MudItem>
                        }

                        <MudItem xs="12" Class="d-flex justify-end gap-2 mt-4">
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save Changes</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }

    private Report? _report;
    private bool _loading = true;
    private MudForm? _form;
    private bool _isAdmin = false;

    private double _originalLat;
    private double _originalLng;
    private bool _mapInitialized = false;
    private DotNetObjectReference<EditReport>? _objRef;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin = authState.User.IsInRole("admin");
        await LoadReportAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
        }

        if (!_loading && _report != null && !_mapInitialized)
        {
            _mapInitialized = true;
            await JSRuntime.InvokeVoidAsync("initPickerMap", "picker-map", _objRef, _report.Latitude, _report.LongTitude);
        }
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }

    [JSInvokable]
    public Task UpdateLocation(double lat, double lng)
    {
        if (_report != null)
        {
            _report.Latitude = lat;
            _report.LongTitude = lng;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    private async Task RevertLocationAsync()
    {
        if (_report != null)
        {
            _report.Latitude = _originalLat;
            _report.LongTitude = _originalLng;
            await JSRuntime.InvokeVoidAsync("updatePickerMapPosition", _originalLat, _originalLng);
            StateHasChanged();
        }
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("ReportService");
            _report = await client.GetFromJsonAsync<Report>($"api/Reports/{Id}");
            if (_report != null)
            {
                _originalLat = _report.Latitude;
                _originalLng = _report.LongTitude;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading report: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_report == null) return;
        
        if (_form != null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient("ReportService");
            var response = await client.PutAsJsonAsync($"api/Reports/{Id}", _report);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Report updated successfully", Severity.Success);
                if (_isAdmin)
                    NavigationManager.NavigateTo("/admin/manage-reports");
                else
                    NavigationManager.NavigateTo("/myreports");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to update report: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving report: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel()
    {
        if (_isAdmin)
            NavigationManager.NavigateTo("/admin/manage-reports");
        else
            NavigationManager.NavigateTo("/myreports");
    }
}
