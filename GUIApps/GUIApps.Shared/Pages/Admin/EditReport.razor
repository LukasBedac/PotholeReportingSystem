@page "/admin/edit-report/{Id:guid}"
@using GUIApps.Shared.Models
@using GUIApps.Shared.Models.Enums
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor

@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

@attribute [Authorize(Roles = "admin")]

<PageTitle>Edit Report</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6">
    <MudText Typo="Typo.h4" Class="mb-4">Edit Report</MudText>

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_report == null)
    {
        <MudAlert Severity="Severity.Error">Report not found.</MudAlert>
    }
    else
    {
        <MudCard>
            <MudCardContent>
                <MudForm @ref="_form">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField Label="Report ID" Value="@_report.Id" ReadOnly="true" Variant="Variant.Filled" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="User ID" Value="@_report.UserID" ReadOnly="true" Variant="Variant.Filled" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Reported At" Value="@_report.ReportedAt.ToLocalTime().ToString("g")" ReadOnly="true" Variant="Variant.Filled" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                             <MudSelect T="ReportStatus" Label="Status" @bind-Value="_report.Status" Variant="Variant.Outlined" Required="true">
                                @foreach (var status in Enum.GetValues<ReportStatus>())
                                {
                                    <MudSelectItem Value="@status">@status</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudSelect T="PotholeCategory" Label="Category" @bind-Value="_report.Category" Variant="Variant.Outlined" Required="true">
                                @foreach (var cat in Enum.GetValues<PotholeCategory>())
                                {
                                    <MudSelectItem Value="@cat">@cat</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Label="Description" @bind-Value="_report.Description" Lines="4" Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Latitude" Value="@_report.Latitude" ReadOnly="true" Variant="Variant.Filled" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Label="Longitude" Value="@_report.LongTitude" ReadOnly="true" Variant="Variant.Filled" />
                        </MudItem>

                        @if (_report.Image != null && !string.IsNullOrEmpty(_report.Image.StorageKey))
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle1">Attached Image</MudText>
                                <MudChip T="string" Color="Color.Info" Icon="@Icons.Material.Filled.Image">@_report.Image.OriginalName</MudChip>
                                <MudText Typo="Typo.caption">Size: @(_report.Image.SizeBytes / 1024) KB</MudText>
                            </MudItem>
                        }

                        <MudItem xs="12" Class="d-flex justify-end gap-2 mt-4">
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Cancel">Cancel</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save Changes</MudButton>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            </MudCardContent>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter] public Guid Id { get; set; }

    private Report? _report;
    private bool _loading = true;
    private MudForm? _form;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _loading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("ReportService");
            _report = await client.GetFromJsonAsync<Report>($"Reports/{Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading report: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_report == null) return;
        
        if (_form != null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        try
        {
            var client = HttpClientFactory.CreateClient("ReportService");
            var response = await client.PutAsJsonAsync($"Reports/{Id}", _report);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Report updated successfully", Severity.Success);
                NavigationManager.NavigateTo("/admin/manage-reports");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to update report: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving report: {ex.Message}", Severity.Error);
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/admin/manage-reports");
    }
}
