@page "/admin/manage-reports"
@using Microsoft.AspNetCore.Authorization
@using GUIApps.Shared.Models
@using GUIApps.Shared.Models.Enums
@using MudBlazor
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

@attribute [Authorize(Roles = "admin")]

<PageTitle>@Loc["EditReports"]</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@Loc["EditReports"]</MudText>

@if (_loading)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudTable Items="@_reports" Hover="true" Striped="true" Filter="FilterFunc" SortLabel="@Loc["SortBy"]">
        <ToolBarContent>
            <MudText Typo="Typo.h6">@Loc["AllReports"]</MudText>
            <MudSpacer />
            <MudTextField @bind-Value="searchString" Placeholder="@Loc["Search"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
        </ToolBarContent>
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="@((Report x) => (object) x.Id)">ID</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="@((Report x) => x.Category)">@Loc["Category"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="@((Report x) => x.Status)">@Loc["Status"]</MudTableSortLabel></MudTh>
            <MudTh>@Loc["Description"]</MudTh>
            <MudTh><MudTableSortLabel SortBy="@((Report x) => (object)x.ReportedAt)">@Loc["Date"]</MudTableSortLabel></MudTh>
            <MudTh>@Loc["Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="@Loc["Category"]">@Loc[context.Category.ToString()]</MudTd>
            <MudTd DataLabel="@Loc["Status"]">
                 <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)" Variant="Variant.Text">@Loc[context.Status.ToString()]</MudChip>
            </MudTd>
            <MudTd DataLabel="@Loc["Description"]">
                <MudText Typo="Typo.body2" Style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px;">
                    @context.Description
                </MudText>
            </MudTd>
            <MudTd DataLabel="@Loc["Date"]">@context.ReportedAt.ToLocalTime().ToString("g")</MudTd>
            <MudTd DataLabel="@Loc["Actions"]">
                 <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => EditReport(context.Id))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}

@code {
    private List<Report> _reports = new();
    private bool _loading = true;
    private string searchString = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadReportsAsync();
    }

    private async Task LoadReportsAsync()
    {
        _loading = true;
        try
        {
            var client = HttpClientFactory.CreateClient("ReportService");
            _reports = await client.GetFromJsonAsync<List<Report>>("api/Reports") ?? new List<Report>();
        }
        catch (Exception ex)
        {
            Snackbar.Add(Loc["FailedLoadReports"].Value, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void EditReport(Guid id)
    {
        NavigationManager.NavigateTo($"/admin/edit-report/{id}");
    }

    private bool FilterFunc(Report report)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;
        if (report.Description?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false)
            return true;
        if (report.Category.ToString().Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private Color GetStatusColor(ReportStatus status)
    {
        return status switch
        {
            ReportStatus.Reported => Color.Info,
            ReportStatus.UnderReview => Color.Warning,
            ReportStatus.Rejected => Color.Error,
            ReportStatus.Repaired => Color.Success,
            ReportStatus.Inprogress => Color.Warning,
            ReportStatus.CannotBeRepaired => Color.Dark,
            _ => Color.Default
        };
    }
}
