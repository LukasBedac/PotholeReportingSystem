{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Oidc": {
    "Authority": "http://localhost:8080/realms/PotholeReportSystem",
    "ClientId": "pothole-web"
  },
  "ReverseProxy": {
    "Routes": {
      "reports-route": {
        "ClusterId": "reports-cluster",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      },
      "files-route": {
        "ClusterId": "files-cluster",
        "Match": {
          "Path": "/api/files/{**catch-all}"
        }
      },
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": {
          "Path": "/api/admins/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "reports-cluster": {
        "Destinations": {
          "reports-service": {
            "Address": "http://reports-service:8080/"
          }
        }
      },
      "files-cluster": {
        "Destinations": {
          "files-service": {
            "Address": "http://filestorage-service:8080/"
          }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "admin-service": {
            "Address": "http://admin-service:8080/"
          }
        }
      }
    }
  }
}
